# Copy to server/.env. Never put keys in VITE_ variables.
CHAT_PROVIDER=openrouter
# For local chat: CHAT_PROVIDER=ollama, DEFAULT_CHAT_MODEL=dolphin3:latest,
# CHAT_MODEL_ALLOWLIST=dolphin3:latest. Install Ollama and run ollama pull dolphin3.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Use unique names. Backups are optional and never increase shared account quota.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
DEFAULT_CHAT_MODEL=openrouter/free
CHAT_MODEL_ALLOWLIST=openrouter/free
# Optional, separate image provider.
OPENAI_IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1-mini
FRONTEND_ORIGIN=http://127.0.0.1:5173
HOST=127.0.0.1
PORT=3001
